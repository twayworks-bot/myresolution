# ===================================================================
# .gitignore for 말씀 나눔 매거진 웹앱
# ===================================================================

# -------------------------------------------------------------------
# 1. 개인정보 및 민감 데이터 / 인증 파일 (Secrets & Credentials)
# -------------------------------------------------------------------
.env
.env.*
*.env
syncgithub.env
syncgithub.py

# 비밀 키, 인증서 및 토큰 파일
*.pem
*.key
*.pub
*.crt
*.pfx
*.p12
id_rsa*
id_ed25519*
*.token
tokens.json
credentials.json
client_secrets*.json
secrets.*
*.auth
*.secret

# 클라우드 / Git 인증 디렉토리
.aws/
.gcp/
.azure/
.gh/

# -------------------------------------------------------------------
# 2. 데이터베이스 & 영구 데이터 (Databases & Persistent Volumes)
# -------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite3-journal
*.db-wal
*.db-shm
sermon_sharing.db
data/
db.sqlite3
db.sqlite3-journal

# -------------------------------------------------------------------
# 3. 파이썬 캐시 & 빌드 산출물 (Python Cache & Build Artifacts)
# -------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# 빌드 및 배포
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec

# -------------------------------------------------------------------
# 4. 가상환경 (Virtual Environments)
# -------------------------------------------------------------------
.venv/
.venv*/
venv/
env/
ENV/
env.bak/
venv.bak/
__pypackages__/

# -------------------------------------------------------------------
# 5. 테스트, 커버리지 & 린터 캐시 (Testing & Linter Caches)
# -------------------------------------------------------------------
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
*.cover
*.py,cover
.hypothesis/
.dmypy.json
dmypy.json
.pyre/
.pytype/
cython_debug/

# -------------------------------------------------------------------
# 6. IDE, 텍스트 에디터 & OS 설정 (Editor & OS Settings)
# -------------------------------------------------------------------
# Visual Studio Code
.vscode/
*.code-workspace

# JetBrains (PyCharm 등)
.idea/
*.iml
*.iws

# 기타 에디터
.spyderproject
.spyproject
.ropeproject
*.swp
*.swo
*~
*.sublime-*

# 운영체제 파일
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -------------------------------------------------------------------
# 7. 로그 & 임시 파일 (Logs & Temporary Files)
# -------------------------------------------------------------------
*.log
logs/
pip-log.txt
pip-delete-this-directory.txt
*.tmp
*.temp
*.bak
*.backup
*.dump
*.sql
*.sql.gz

# -------------------------------------------------------------------
# 8. 개인 메모 및 내부 요구사항 문서 (Private Notes)
# -------------------------------------------------------------------
notes/
